# Optional LLM provider: openrouter, google, groq, or ollama. Leave blank to use deterministic shopping.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY= 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
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Required for persistent session signing: set a long random value before deploying.
# Locally, the app uses a temporary session key if this remains the placeholder.
FLASK_SECRET_KEY=replace-this-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# FAQ embedding model downloads once and is cached locally by sentence-transformers.
FAQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
